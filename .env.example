APP_NAME="ERP LPK Jepang"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
ASSET_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Instance branding. Keep organization/contact values as placeholders until
# the new LPK supplies its approved identity and public contact information.
BRAND_APP_NAME="ERP LPK Jepang"
BRAND_SHORT_NAME="ERP LPK Jepang"
BRAND_ORGANIZATION_NAME="Nama LPK / Perusahaan"
BRAND_TAGLINE="Sistem Manajemen LPK Jepang"
BRAND_ADDRESS="Alamat LPK / perusahaan"
BRAND_PHONE=
BRAND_WHATSAPP=
BRAND_EMAIL=admin@localhost.test
BRAND_WEBSITE=
BRAND_NPWP=
BRAND_LOGO=img/erp-lpk-jepang-logo.png
BRAND_FAVICON=img/erp-lpk-jepang-favicon.png
BRAND_LOGIN_BACKGROUND=img/erp-lpk-jepang-login-bg.png
BRAND_PRIMARY_COLOR="#DC2626"
BRAND_SECONDARY_COLOR="#0F172A"
BRAND_ACCENT_COLOR="#F59E0B"
BRAND_SIDEBAR_BG="#0F172A"
BRAND_SIDEBAR_TEXT="#CBD5E1"
BRAND_SIDEBAR_ACTIVE_BG="#7F1D1D"
BRAND_SIDEBAR_ACTIVE_TEXT="#FFFFFF"
BRAND_TOPBAR_BG="#FFFFFF"
BRAND_TOPBAR_TEXT="#0F172A"
BRAND_PAGE_BG="#F1F5F9"
BRAND_CARD_BG="#FFFFFF"
BRAND_BANK_NAME=
BRAND_BANK_ACCOUNT=
BRAND_BANK_HOLDER="Nama LPK / Perusahaan"
BRAND_BANK_BRANCH=
BRAND_SIGNER_NAME="Nama Penandatangan"
BRAND_SIGNER_TITLE="Pimpinan LPK"
BRAND_ISSUE_CITY="Kota penerbit"
BRAND_DOCUMENT_PREFIX=DOC/LPK/
BRAND_INSTAGRAM_URL=
BRAND_TIKTOK_URL=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wms_mysql
DB_USERNAME=root
DB_PASSWORD=
WMS_RUNTIME_DB_CONNECTION=mysql
WMS_RUNTIME_DB_DATABASE=wms_mysql

# Dedicated local-only destination used by the read-only M1 import command.
# WMS_MIGRATION_DB_HOST=127.0.0.1
# WMS_MIGRATION_DB_PORT=3306
# WMS_MIGRATION_DB_DATABASE=wms_mysql
# WMS_MIGRATION_DB_USERNAME=
# WMS_MIGRATION_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ALLOWED_DOMAIN=

# Optional, one-time local provisioning input. Never commit a real password.
MASTER_ADMIN_PASSWORD=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=
MICROSOFT_OAUTH_TENANT=common

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"
